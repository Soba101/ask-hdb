# Copy to .env and fill in. .env is git-ignored.
DATAGOV_API_KEY=
LLM_PROVIDER=local
LLM_MODEL=qwen3.5-9b-16k
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=none
LLM_TIMEOUT=180
LLM_REASONING_EFFORT=none
ONEMAP_EMAIL=
ONEMAP_PASSWORD=
# Optional tracing (uv sync --extra tracing). Off unless both keys are set; text is redacted unless TRACE_TEXT=1.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# TRACE_TEXT=0
# Optional limits and Docker settings
# API_RATE_PER_MINUTE=6
# API_DAILY_TOKEN_CAP=2000000
# API_QUEUE_WAIT=30
# BIND_ADDR=127.0.0.1
